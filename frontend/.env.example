# ════════════════════════════════════════════════════════════════
# TravelMate-AI — Frontend Environment Variables Template
# ════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit .env — it is excluded by .gitignore.
# For production, set VITE_API_BASE_URL in the Vercel dashboard.
# DO NOT create a .env.production file.
# ════════════════════════════════════════════════════════════════

# ── Backend API URL ──────────────────────────────────────────
# Local development — points to your local FastAPI server:
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Production — set this in the Vercel dashboard (Environment Variables section),
# NOT in a file. Example value:
# VITE_API_BASE_URL=https://travelmate-api.onrender.com/api/v1
