# ════════════════════════════════════════════════════════════════
# TravelMate-AI — Backend Environment Variables Template
# ════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your real values:
#   cp .env.example .env
#
# NEVER commit .env — it is excluded by .gitignore.
# This .env.example file contains NO real secrets and IS committed.
# ════════════════════════════════════════════════════════════════

# ── IBM watsonx.ai ───────────────────────────────────────────
# Required for AI endpoints (/api/v1/ai/*, /api/v1/chat/*)
# Get your API key:    IBM Cloud → Manage → API keys → Create
# Get your project ID: watsonx.ai → Your project → Manage → General
WATSONX_API_KEY=K9RMm94SokP0yok6vAAhrZyQWiDd2itZtyNBYVM3G232
WATSONX_PROJECT_ID=b5237821-5e43-445b-a13b-9ce66d0fe06b
WATSONX_URL=https://us-south.ml.cloud.ibm.com
GRANITE_MODEL_ID=ibm/granite-4-h-small

# ── IBM Cloudant ─────────────────────────────────────────────
# Required for itinerary/chat save-load endpoints
# Get credentials: IBM Cloud → Cloudant service → Service credentials → New credential
CLOUDANT_URL=https://your-instance.cloudantnosqldb.appdomain.cloud
CLOUDANT_APIKEY=your_cloudant_api_key_here
CLOUDANT_DB_ITINERARIES=travelmate_itineraries
CLOUDANT_DB_CHAT=travelmate_chat_sessions

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slash).
# Local development:
CORS_ORIGINS=http://localhost:5173
# Production example (set in Render dashboard instead of here):
# CORS_ORIGINS=https://your-app.vercel.app

# ── App ──────────────────────────────────────────────────────
# Use "development" locally; "production" is set automatically by render.yaml
ENVIRONMENT=development
